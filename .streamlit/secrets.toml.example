# Copy to .streamlit/secrets.toml (gitignored) and set a value.
# Deployed, the same key goes in App settings -> Secrets.
#
# The app is on the open internet with no rate limiting, so this passphrase's
# entropy is the whole defence. Use a long random one, never a memorable one,
# and distribute the URL and the password separately.
app_password = "change-me-to-something-long-and-random"
